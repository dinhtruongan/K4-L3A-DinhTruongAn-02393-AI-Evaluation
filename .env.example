# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Choose 'openai' (default) or 'gemini'. Gemini uses the OpenAI-compatible API.
LLM_PROVIDER=openai
# For Gemini: set LLM_PROVIDER=gemini and fill these values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
